# Copy this file to .env and fill in your local values. .env is gitignored.
# A value may be wrapped in one pair of matching quotes ("..." or '...'),
# which the loaders strip - quotes are optional, but handy for a Windows path
# with spaces.

# Absolute path to a Node.js executable used to launch the OmniRoute gateway.
# Falls back to "node" on PATH when unset.
OMNIROUTE_NODE=node

# Absolute or resolvable path to the OmniRoute CLI entry point (omniroute.mjs).
# Required: with no OMNIROUTE_ENTRY set, the start actions fail with a clear
# message instead of guessing a path relative to the spawning process' cwd.
OMNIROUTE_ENTRY=omniroute/bin/omniroute.mjs
