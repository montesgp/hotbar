# Copy this file to .env and fill in your local values. .env is gitignored.

# Absolute path to a Node.js executable used to launch the OmniRoute gateway.
# Falls back to "node" on PATH when unset.
OMNIROUTE_NODE=node

# Absolute or resolvable path to the OmniRoute CLI entry point (omniroute.mjs).
# Falls back to "omniroute/bin/omniroute.mjs" when unset.
OMNIROUTE_ENTRY=omniroute/bin/omniroute.mjs
